# Copy to .env on the school lunch server. Every value below is a placeholder.
CAFETERIA_NAME=your-school-name
DATABASE_URL=postgres://user:password@localhost:5432/cafeteria
OPENAI_API_KEY=your-openai-key
LUNCH_VENDOR_SECRET=replace-with-vendor-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
POS_TERMINAL_ID=your-terminal-id
MENU_TIMEZONE=America/Chicago
BREAKFAST_OPENS=07:15
LUNCH_OPENS=10:45
LUNCH_CLOSES=13:15
ALLERGEN_REVIEW_EMAIL=nutrition@example.edu
PAYMENT_WEBHOOK_PATH=/hooks/lunch-pos
FEATURE_SECOND_ENTREE=false
MAX_MEAL_SWIPES=2
