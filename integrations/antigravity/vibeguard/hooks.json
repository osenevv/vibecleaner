{
  "vibeguard": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/vibeguard-hook.sh post-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/vibeguard-hook.sh stop",
        "timeout": 120
      }
    ]
  }
}
